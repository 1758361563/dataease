DE_BASE_URL=http://localhost:8080
DE_SCREENSHOT_USER=
DE_SCREENSHOT_PASSWORD=
FEISHU_SHOT_PORT=8091

# Service-to-service token. Required for POST /v1/deliveries. Do not commit the real value.
FEISHU_INTERNAL_TOKEN=

# 气味数据 / 观远正在使用的企业自建应用。真实值只放 .env，不要提交。
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=

# 测试群 chat_id（receive_id_type=chat_id）
FEISHU_TEST_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 观远「飞书账号」字段，按 user_id 发送个人消息（receive_id_type=user_id）
# 不要再使用 FEISHU_TEST_OPEN_ID
FEISHU_TEST_USER_ID=

# Optional screenshot verify overrides
# DE_VERIFY_DASHBOARD_ID=1292912367851671552
# DE_VERIFY_CHART_ID=7501169547546726400

# mysql-de / dataease — same instance DataEase uses. Password stays in .env only.
DE_MYSQL_DOCKER=mysql-de
DE_MYSQL_DATABASE=dataease
DE_MYSQL_USER=root
DE_MYSQL_PASSWORD=
