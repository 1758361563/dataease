# Company BI metadata MySQL (8.4). Mirrors the DataEase installer's my.cnf where it matters
# (READ-COMMITTED, STRICT sql_mode, 64M packets) but sized for a small co-hosted instance.
[mysqld]
character_set_server=utf8mb4
collation_server=utf8mb4_0900_ai_ci
default-storage-engine=INNODB
default-time-zone='+08:00'
skip-name-resolve

transaction_isolation=READ-COMMITTED
sql_mode=STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
max_allowed_packet=64M
innodb_lock_wait_timeout=1800
innodb_file_per_table=1

# Memory: the container limit is 768 MiB by default. Keep the instance well inside it.
innodb_buffer_pool_size=256M
innodb_log_buffer_size=16M
max_connections=200
table_open_cache=256
performance_schema=OFF

# Binary log kept briefly for point-in-time inspection; the real recovery path is
# scripts/backup-db.sh (mysqldump taken before every upgrade).
binlog_expire_logs_seconds=259200
max_binlog_size=100M

[client]
default-character-set=utf8mb4
