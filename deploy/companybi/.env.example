# Company BI deployment settings.
#
# Copy to ".env" (same directory as compose.yaml), chmod 600, fill in the blanks.
# `scripts/install.sh --init-env` can create it for you with random database passwords
# and token secret; it leaves COMPANY_BI_BOOTSTRAP_PASSWORD empty on purpose.
#
# Rules:
#   * ".env" is git-ignored. Never commit it, never bake it into an image, never paste it into chats/logs.
#   * Values are read by Docker Compose AND by the scripts, as literal KEY=VALUE (no shell
#     evaluation): no quotes. Secrets and paths: no spaces, and none of  $  `  "  '  \  #
#     (use letters/digits, - and _). Only COMPANY_BI_JAVA_OPTS may contain spaces.
#   * After the first successful install do not change the DB passwords here: they are
#     applied to MySQL only when its data directory is empty. Rotating them later is a
#     manual ALTER USER + edit of this file (see docs/deployment.md).

# --- Identity of this stack (all docker objects are prefixed with it) --------
# Keep "companybi" in production. Use something else only for an isolated test stack.
COMPANY_BI_PROJECT=companybi

# --- Where everything persistent lives on the host --------------------------
# mysql/data, app/{data,conf,cache,logs}, backups/, releases/, images/ are created here.
# Must be on a disk with enough space; never inside a Git checkout.
COMPANY_BI_HOME=/data/companybi

# --- Network ----------------------------------------------------------------
# Loopback only. Reach the UI with:  ssh -L 30005:127.0.0.1:30005 <user>@<tower>
COMPANY_BI_BIND_ADDR=127.0.0.1
COMPANY_BI_PORT=30005
# Browser origins allowed by DataEase CORS (comma separated). Must match how you open the UI.
COMPANY_BI_ORIGIN_LIST=http://localhost:30005,http://127.0.0.1:30005

# --- Metadata database (NOT the business database) ---------------------------
# Business data such as qiwei_new_bi is added later as a DataEase *datasource* (read-only account).
COMPANY_BI_MYSQL_IMAGE=mysql:8.4.5
COMPANY_BI_DB_NAME=companybi_meta
COMPANY_BI_DB_USER=companybi
COMPANY_BI_DB_PASSWORD=
COMPANY_BI_DB_ROOT_PASSWORD=

# --- Application secrets ----------------------------------------------------
# Initial administrator (company_bi_user.id=1). Used ONLY when that row does not exist,
# i.e. on first start. Choose it yourself (>= 12 chars). It is never overwritten later.
COMPANY_BI_BOOTSTRAP_PASSWORD=
# HMAC secret for login tokens. Keep it stable across upgrades; changing it logs everyone out.
# Back it up with .env.  Generate: openssl rand -hex 32
COMPANY_BI_TOKEN_SECRET=

# --- JVM / container resources ------------------------------------------------
# Initial budget: app container 2 GiB (heap 1 GiB), MySQL 768 MiB. Re-check against the
# host's REAL free memory before installing (install.sh/upgrade.sh do) and tune from
# measured usage (`scripts/status.sh`). Never fix a shortage by touching Guanyuan.
COMPANY_BI_JAVA_OPTS=-Xms512m -Xmx1g -XX:MaxMetaspaceSize=256m -XX:+ExitOnOutOfMemoryError -Duser.timezone=Asia/Shanghai
COMPANY_BI_APP_MEM_LIMIT=2g
COMPANY_BI_MYSQL_MEM_LIMIT=768m
COMPANY_BI_APP_CPUS=2.0
COMPANY_BI_MYSQL_CPUS=1.0

# --- Feishu -------------------------------------------------------------------
# COMPANY_FEISHU_DRY_RUN is forced to "true" in compose.yaml for this phase and is NOT read
# from here. No Feishu credentials belong in this file; the Node/Playwright Feishu service
# is not deployed yet.

# --- Set by the scripts, do not edit -----------------------------------------
# Set true to disable both formal and test ETL execution at the deployment layer.
COMPANY_BI_ETL_HARD_DISABLE=false
# COMPANY_BI_INSTANCE_ID is resolved from this ECS host by the deployment scripts.
# Do not save or copy an instance ID in .env.
# COMPANY_BI_VERSION lives in ${COMPANY_BI_HOME}/releases/version.env (written by install/upgrade/rollback).
